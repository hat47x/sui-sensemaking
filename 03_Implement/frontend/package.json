{
  "name": "sui-sensemaking-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:regression-guards": "vitest run src/import/zip_import.test.ts src/import/schema_validation.test.ts src/import/document_import.test.ts src/import/view_import.test.ts src/diff/review_pack_workflow.integration.test.ts src/export/bundle_export.test.ts src/export/view_metadata.test.ts src/domain/validate_doc.test.ts src/export/canvas_svg.test.ts src/ui/ux_operability_regression.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "e2e": "playwright test",
    "e2e:full": "playwright test && playwright test --config=playwright.perf.config.ts",
    "e2e:perf": "playwright test --config=playwright.perf.config.ts",
    "e2e:headed": "playwright test --headed",
    "publish:static": "node ./scripts/build_static_publish.mjs",
    "capture:release-screenshots": "node ./scripts/capture_release_screenshots.mjs",
    "test:i18n": "vitest run src/i18n/translate.test.ts src/i18n/key_consistency.test.ts src/i18n/ui_hardcode_guard.test.ts src/i18n/catalog_integrity.test.ts",
    "test:i18n-security": "vitest run src/i18n/locale_conversion_guard.test.ts",
    "test:i18n-regression": "vitest run src/i18n/view_locale_resolution.test.ts src/i18n/document_locale_invariance.test.ts",
    "verify:integrity": "node ./scripts/verify_artifact_integrity.mjs",
    "e2e:mock": "playwright test e2e/ce3_patch_workspace.spec.ts e2e/auth_context_level1_smoke.spec.ts",
    "e2e:regression-harness": "./scripts/run_e2e_regression.sh",
    "e2e:prod-tti": "vite build && playwright test --config=playwright.prod-tti.config.ts"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "4.0.18"
  }
}
